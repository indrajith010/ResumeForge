CORS_ORIGINS=http://localhost:5173

FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# LM Studio must be running locally with a model loaded (or available for
# JIT-load) at LM_STUDIO_BASE_URL. LM_STUDIO_MODEL must exactly match a model
# id from LM Studio's own list (GET {LM_STUDIO_BASE_URL}/models, or
# `lms ps` / the loaded-models list in the LM Studio app) — leaving it blank
# causes LM Studio to reject requests with "No models loaded" unless a model
# is already resident in memory. LM_STUDIO_TIMEOUT should stay generous since
# LM Studio can take up to a minute to JIT-load a model on the first request.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=
LM_STUDIO_TIMEOUT=60
